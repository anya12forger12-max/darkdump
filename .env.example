# Development-only example values. Copy to .env for local overrides.
# Placeholders only: never put credentials, tokens, or other secrets here.

# Flask bind address/port for direct `python darkdump-web/app.py` runs or
# `docker run -e ...`. Local defaults are 127.0.0.1:50001; the compose service
# pins 0.0.0.0:50001 in docker-compose.yml so the port can be published.
DARKDUMP_HOST=0.0.0.0
DARKDUMP_PORT=50001

# Local tag produced by `docker compose build`. For a published image use a
# pinned GHCR tag instead, e.g. ghcr.io/<OWNER>/<REPO>:web-<sha>.
DARKDUMP_WEB_IMAGE=darkdump-web:local
